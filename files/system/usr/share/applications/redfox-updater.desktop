[Desktop Entry]
Name=RedFox Updater
Comment=Update the system, Flatpaks, Brew and applications
Exec=redfox-hub --page updates
Icon=redfox-updater
Terminal=false
Type=Application
Categories=System;Settings;
# The updater is now RedFox Hub's Updates page. This entry stays, hidden from
# the app grid, so anything that opens it (a pinned launcher) still works.
NoDisplay=true
