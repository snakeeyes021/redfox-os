#!/usr/bin/env python3
"""
redfox-config: Unified Declarative Configuration Engine for RedFoxOS
Manages on-device secrets, preferences, and per-machine settings (hostname,
hardware quirks) stored in ~/.config/redfox/config.yaml.

One config file can describe all of a user's machines:

    machines:
      ABC123SERIAL:          # DMI serial, board_version, product_name, ...
        hostname: oryx
        quirks: [fix-oryp9-mouse]

`setup` also takes a config encrypted with `age -p` (binary or --armor), from any
source: it asks for the passphrase, decrypts it without temporary files and saves the
plain config as ~/.config/redfox/config.yaml (readable only by you).

An optional `profile_picture:` (a base64 PNG or JPEG) becomes the account picture
(login screen, Settings) when setup runs.
"""

import os
import sys
import argparse
import json
import subprocess
import urllib.request
import urllib.error
from pathlib import Path


def get_user_home() -> Path:
    """Resolve the real user home directory, even when run via sudo."""
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and sudo_user != "root":
        for p in [Path(f"/var/home/{sudo_user}"), Path(f"/home/{sudo_user}")]:
            if p.exists():
                return p
    return Path.home()


USER_CONFIG_DIR = get_user_home() / ".config" / "redfox"
USER_CONFIG_PATH = USER_CONFIG_DIR / "config.yaml"
DMI_SERIAL_PATH = Path("/sys/class/dmi/id/product_serial")


def load_yaml(path: Path) -> dict:
    """Load a YAML mapping from disk (empty dict if missing or not a mapping)."""
    import yaml
    if not path.exists():
        return {}
    with open(path, "r", encoding="utf-8") as f:
        data = yaml.safe_load(f)
    return data if isinstance(data, dict) else {}


def parse_yaml_text(text: str) -> dict:
    """Parse raw YAML string."""
    import yaml
    data = yaml.safe_load(text)
    if isinstance(data, dict):
        return data
    raise ValueError("Configuration YAML must be a mapping/dictionary of key-values.")


def save_config_text(text: str):
    """Save raw text to ~/.config/redfox/config.yaml with 0600 permissions (backing up previous)."""
    USER_CONFIG_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if USER_CONFIG_PATH.exists():
        try:
            import shutil
            shutil.copy2(USER_CONFIG_PATH, USER_CONFIG_PATH.with_suffix(".yaml.bak"))
        except Exception:
            pass
    tmp = USER_CONFIG_PATH.with_name(f".{USER_CONFIG_PATH.name}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text.strip() + "\n")
    os.replace(tmp, USER_CONFIG_PATH)


def section(cfg: dict, key: str) -> dict:
    """Return a mapping section of the config (empty dict if unset, empty, or not a mapping)."""
    val = cfg.get(key)
    return val if isinstance(val, dict) else {}


def get_current_dmi_serial() -> str:
    """Read hardware product serial from sysfs."""
    if DMI_SERIAL_PATH.exists():
        try:
            with open(DMI_SERIAL_PATH, "r", encoding="utf-8") as f:
                serial = f.read().strip()
                if serial and serial not in ("None", "Default string", "System Serial Number"):
                    return serial
        except Exception:
            pass
    # Try via non-interactive sudo (never blocks or hijacks terminal)
    try:
        res = subprocess.run(["sudo", "-n", "cat", str(DMI_SERIAL_PATH)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=1)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except Exception:
        pass
    return ""


def get_hardware_identifiers(explicit_serial: str = None) -> list:
    """Return priority-ordered list of hardware identifiers for this device:
    1. DMI product serial (explicit or detected)
    2. DMI board_version (e.g. 'oryp9')
    3. DMI product_name (e.g. 'Oryx Pro')
    4. DMI product_version
    5. DMI board_name
    """
    identifiers = []
    serial = (explicit_serial or get_current_dmi_serial() or "").strip()
    if serial:
        identifiers.append(serial)

    for filename in ["board_version", "product_name", "product_version", "board_name"]:
        p = Path(f"/sys/class/dmi/id/{filename}")
        if p.exists():
            try:
                val = p.read_text(encoding="utf-8").strip()
                if val and val not in ("None", "Default string", "System Serial Number") and val not in identifiers:
                    identifiers.append(val)
            except Exception:
                pass

    return identifiers


def find_machine(cfg: dict, explicit_id: str = None) -> tuple:
    """Find this device's entry under `machines:`. Returns (matched_id, entry) or (None, None).

    An explicit identifier (e.g. a serial read via sudo) is tried first, then the
    auto-detected identifiers in priority order.
    """
    machines = section(cfg, "machines")
    if not machines:
        return None, None
    entries = {str(k).strip(): v for k, v in machines.items()}
    candidates = ([explicit_id.strip()] if explicit_id and explicit_id.strip() else []) + get_hardware_identifiers()
    for ident in candidates:
        if ident in entries:
            entry = entries[ident]
            return ident, entry if isinstance(entry, dict) else {}
    return None, None


def as_list(val) -> list:
    """Normalize a scalar-or-list YAML value to a list of non-empty strings."""
    if val is None:
        return []
    items = val if isinstance(val, list) else [val]
    return [str(v).strip() for v in items if v is not None and str(v).strip()]


def warn_legacy_quirks(cfg: dict):
    if section(cfg, "hardware").get("quirks"):
        print("[WARN] 'hardware.quirks' is no longer used. Move each entry to 'machines:', e.g.\n"
              "  machines:\n    <serial-or-model>:\n      quirks: [<recipe>]", file=sys.stderr)


# --- Encrypted configs (age, passphrase) ---

AGE_ARMOR_BEGIN = b"-----BEGIN AGE ENCRYPTED FILE-----"
AGE_ARMOR_END = "-----END AGE ENCRYPTED FILE-----"
AGE_BINARY_HEADER = b"age-encryption.org/"
PASSPHRASE_TRIES = 3


class WrongPassphrase(Exception):
    pass


def is_encrypted(data: bytes) -> bool:
    """True for an age file, binary or armored."""
    return data.startswith(AGE_BINARY_HEADER) or data.lstrip().startswith(AGE_ARMOR_BEGIN)


def age_decrypt(data: bytes, passphrase: str) -> bytes:
    """Decrypt a passphrase-encrypted age file in memory.

    age reads passphrases only from a terminal, so it runs on a private
    pseudo-terminal and the passphrase is typed into that once age has turned
    echo off to read it. The plaintext comes back on a pipe and never touches disk.
    """
    import shutil
    import termios
    import threading
    import time

    age = shutil.which("age")
    if not age:
        raise RuntimeError("age isn't installed, so an encrypted config can't be read.")

    master, slave = os.openpty()
    slave_name = os.ttyname(slave)

    def attach_terminal():
        os.setsid()
        os.close(os.open(slave_name, os.O_RDWR))  # the controlling terminal: age's /dev/tty

    try:
        proc = subprocess.Popen([age, "--decrypt"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, preexec_fn=attach_terminal)
    except BaseException:
        os.close(master)
        os.close(slave)
        raise
    os.close(slave)

    def feed():
        try:
            proc.stdin.write(data)
            proc.stdin.close()
        except (BrokenPipeError, OSError):
            pass

    feeder = threading.Thread(target=feed, daemon=True)
    feeder.start()
    try:
        deadline = time.monotonic() + 10
        while proc.poll() is None and time.monotonic() < deadline:
            if not termios.tcgetattr(master)[3] & termios.ECHO:
                break
            time.sleep(0.02)
        if proc.poll() is None:
            os.write(master, passphrase.encode("utf-8") + b"\n")
        try:
            out, err = proc.communicate(timeout=120)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.communicate()
            raise RuntimeError("age didn't finish decrypting the config.")
    finally:
        feeder.join(timeout=5)
        os.close(master)

    if proc.returncode == 0:
        return out
    message = err.decode("utf-8", "replace")
    if "incorrect passphrase" in message:
        raise WrongPassphrase()
    if "not passphrase-encrypted" in message:
        raise RuntimeError("This file is encrypted to a key, not a passphrase. Encrypt it with 'age -p'.")
    first = next((line for line in message.splitlines() if line.strip()), "unknown error")
    raise RuntimeError(f"age couldn't decrypt the config: {first.removeprefix('age: error: ')}")


def ask_passphrase(prompt: str) -> str:
    """Read a passphrase from the terminal without echoing it (the terminal even if stdin is a pipe)."""
    import getpass
    try:
        with open("/dev/tty"):
            pass
    except OSError:
        raise RuntimeError("An encrypted config needs its passphrase typed in a terminal.")
    return getpass.getpass(prompt)


def decrypt_config(data: bytes, ask=None) -> bytes:
    """Ask for the passphrase and decrypt, with a retry for a wrong one. None if the user gives up."""
    import shutil
    if not shutil.which("age"):  # before asking for a passphrase that can't be used
        raise RuntimeError("age isn't installed, so an encrypted config can't be read.")
    ask = ask or ask_passphrase
    print("This config is encrypted.")
    for attempt in range(1, PASSPHRASE_TRIES + 1):
        passphrase = ask("Passphrase (Enter to cancel): ")
        if not passphrase:
            return None
        try:
            return age_decrypt(data, passphrase)
        except WrongPassphrase:
            if attempt < PASSPHRASE_TRIES:
                print("That passphrase is wrong. Try again.")
    print(f"[ERROR] Wrong passphrase {PASSPHRASE_TRIES} times. Configuration unchanged.")
    sys.exit(1)


def graphical_session() -> bool:
    return bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


def pick_file() -> str:
    """Choose a config file in a file picker. Empty if cancelled or there's no picker."""
    try:
        res = subprocess.run(["zenity", "--file-selection", "--title=Choose Your RedFox Config"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return ""
    return res.stdout.strip() if res.returncode == 0 else ""


def unquote(text: str) -> str:
    """A path dropped into a terminal can arrive in quotes."""
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "'\"":
        return text[1:-1]
    return text


# --- Profile picture ---

PICTURE_FORMATS = {b"\x89PNG\r\n\x1a\n": "png", b"\xff\xd8\xff": "jpg"}
MAX_PICTURE_BYTES = 1048576  # AccountsService refuses bigger icon files


def decode_picture(value) -> tuple:
    """(bytes, extension) from a base64 PNG or JPEG (a data: URL prefix is fine). Raises ValueError."""
    import base64
    import binascii
    too_big = ValueError("profile_picture is over 1 MB; use a smaller image (256 px is plenty).")
    if isinstance(value, bytes):  # YAML's !!binary form arrives already decoded
        data = value
    else:
        text = str(value).strip()
        if text.startswith("data:") and "," in text:
            text = text.split(",", 1)[1]
        if len(text) > MAX_PICTURE_BYTES * 4 // 3 + 4096:  # don't decode something far too big
            raise too_big
        try:
            data = base64.b64decode("".join(text.split()), validate=True)
        except (binascii.Error, ValueError):
            raise ValueError("profile_picture isn't valid base64.")
    ext = next((e for magic, e in PICTURE_FORMATS.items() if data.startswith(magic)), None)
    if not ext:
        raise ValueError("profile_picture must be a PNG or JPEG image.")
    if len(data) > MAX_PICTURE_BYTES:
        raise too_big
    return data, ext


def set_account_picture(path: Path):
    """Set the current user's account picture through AccountsService (login screen, Settings)."""
    import pwd
    user = pwd.getpwuid(os.getuid()).pw_name
    found = subprocess.run(
        ["gdbus", "call", "--system", "--dest", "org.freedesktop.Accounts",
         "--object-path", "/org/freedesktop/Accounts",
         "--method", "org.freedesktop.Accounts.FindUserByName", user],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20)
    if found.returncode != 0:
        raise RuntimeError(found.stderr.strip() or "AccountsService didn't find this user.")
    import re
    match = re.search(r"'(/[^']+)'", found.stdout)
    if not match:
        raise RuntimeError("AccountsService didn't find this user.")
    object_path = match.group(1)
    done = subprocess.run(
        ["gdbus", "call", "--system", "--dest", "org.freedesktop.Accounts",
         "--object-path", object_path,
         "--method", "org.freedesktop.Accounts.User.SetIconFile", str(path)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20)
    if done.returncode != 0:
        raise RuntimeError(done.stderr.strip() or "AccountsService didn't take the picture.")


def apply_profile_picture(cfg: dict):
    """Apply `profile_picture:` (base64 image) as the account picture. Returns a summary line, or None if unset."""
    value = cfg.get("profile_picture")
    if not value:
        return None
    if os.getuid() == 0:
        return "  [!] Profile picture : Not applied (run setup as yourself, not as root)."
    import tempfile
    try:
        data, ext = decode_picture(value)
        with tempfile.TemporaryDirectory(prefix="redfox-picture-") as tmp:
            path = Path(tmp) / f"picture.{ext}"
            # Private to you: accounts-daemon reads a user's file as that user.
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as f:
                f.write(data)
            set_account_picture(path)
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as e:
        return f"  [!] Profile picture : Not applied: {e}"
    return "  [✔] Profile picture : Set as your account picture."


# --- Mailspring accounts ---
#
# mailspring:
#   accounts: [...]        Mailspring's account entries (no passwords in them)
#   credentials: <base64>  its saved logins, encrypted with the key below
#   portal_token: <base64> that key: the Flatpak's Secret-portal token from the keyring
#
# Applied before Mailspring's first start, the accounts come back signed in. The
# token and the saved logins only work together, so they're always written together.

MAILSPRING_APP = "com.getmailspring.Mailspring"
MAILSPRING_CONFIG = get_user_home() / ".var" / "app" / MAILSPRING_APP / "config" / "Mailspring" / "config.json"
MAILSPRING_ACCOUNT_KEYS = ("id", "name", "provider", "emailAddress", "settings", "label", "aliases",
                           "autoaddress", "color")
SECRETS = "org.freedesktop.secrets"


def secret_call(path: str, iface: str, method: str, args, reply: str):
    """One call to the Secret Service (the keyring) on the session bus."""
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    return bus.call_sync(SECRETS, path, iface, method, args, GLib.VariantType(reply),
                         Gio.DBusCallFlags.NONE, 20000, None).unpack()


def _variant(fmt, value):
    from gi.repository import GLib
    return GLib.Variant(fmt, value)


def _portal_token_items() -> list:
    unlocked, locked = secret_call("/org/freedesktop/secrets", "org.freedesktop.Secret.Service", "SearchItems",
                                   _variant("(a{ss})", ({"app_id": MAILSPRING_APP},)), "(aoao)")
    if locked:
        raise RuntimeError("the keyring is locked")
    return list(unlocked)


def _open_session() -> str:
    _, session = secret_call("/org/freedesktop/secrets", "org.freedesktop.Secret.Service", "OpenSession",
                             _variant("(sv)", ("plain", _variant("s", ""))), "(vo)")
    return session


def read_portal_token() -> bytes:
    """Mailspring's Secret-portal token, or b"" if there's none."""
    items = _portal_token_items()
    if not items:
        return b""
    secrets = secret_call("/org/freedesktop/secrets", "org.freedesktop.Secret.Service", "GetSecrets",
                          _variant("(aoo)", (items[:1], _open_session())), "(a{o(oayays)})")[0]
    return bytes(secrets[items[0]][2])


def write_portal_token(token: bytes):
    """Replace Mailspring's Secret-portal token, where the portal looks for it (its app_id)."""
    for item in _portal_token_items():
        prompt = secret_call(item, "org.freedesktop.Secret.Item", "Delete", None, "(o)")[0]
        if prompt != "/":
            raise RuntimeError("the keyring asked for confirmation")
    props = {"org.freedesktop.Secret.Item.Label": _variant("s", f"Secret Portal token for {MAILSPRING_APP}"),
             "org.freedesktop.Secret.Item.Attributes": _variant("a{ss}", {"app_id": MAILSPRING_APP})}
    item, prompt = secret_call(
        "/org/freedesktop/secrets/aliases/default", "org.freedesktop.Secret.Collection", "CreateItem",
        _variant("(a{sv}(oayays)b)", (props, (_open_session(), b"", token, "application/octet-stream"), True)),
        "(oo)")
    if item == "/":
        raise RuntimeError("the keyring asked for confirmation")


def mailspring_running() -> bool:
    try:
        res = subprocess.run(["flatpak", "ps", "--columns=application"], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return False
    return MAILSPRING_APP in res.stdout.split()


def load_mailspring_config() -> dict:
    if not MAILSPRING_CONFIG.exists():
        return {}
    data = json.loads(MAILSPRING_CONFIG.read_text(encoding="utf-8"))
    return data if isinstance(data, dict) else {}


def check_mailspring_section(sec: dict) -> tuple:
    """(accounts, credentials bytes, token bytes) from a mailspring: section. Raises ValueError."""
    import base64
    import binascii
    accounts = sec.get("accounts")
    if not isinstance(accounts, list) or not accounts or \
            not all(isinstance(a, dict) and a.get("emailAddress") and a.get("id") for a in accounts):
        raise ValueError("mailspring.accounts must list the accounts (each with an id and emailAddress).")
    try:
        credentials = base64.b64decode("".join(str(sec.get("credentials", "")).split()), validate=True)
        token = base64.b64decode("".join(str(sec.get("portal_token", "")).split()), validate=True)
    except (binascii.Error, ValueError):
        raise ValueError("mailspring.credentials and mailspring.portal_token must be base64.")
    if not credentials or not token:
        raise ValueError("mailspring needs both credentials and portal_token.")
    return accounts, credentials, token


def apply_mailspring(cfg: dict):
    """Restore Mailspring's accounts, signed in, from `mailspring:`. Returns a summary line, or None if unset."""
    sec = section(cfg, "mailspring")
    if not sec:
        return None
    label = "  [{}] Mailspring      : {}"
    if os.getuid() == 0:
        return label.format("!", "Not applied (run setup as yourself, not as root).")
    try:
        accounts, credentials, token = check_mailspring_section(sec)
        existing = load_mailspring_config()
        star = existing.get("*") if isinstance(existing.get("*"), dict) else {}
        if star.get("accounts"):
            return label.format("―", "Mailspring already has accounts here; left as it is.")
        if mailspring_running():
            return label.format("!", "Not applied: Mailspring is open. Quit it and run setup again.")
        write_portal_token(token)
        # RedFox may have written this file already (its theme); keep everything else in it.
        star.update({"accounts": accounts, "accountsVersion": 1,
                     "credentials": {"type": "Buffer", "data": list(credentials)}})
        existing["*"] = star
        MAILSPRING_CONFIG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        tmp = MAILSPRING_CONFIG.with_name(f".{MAILSPRING_CONFIG.name}.tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(existing, f, indent=2)
        os.replace(tmp, MAILSPRING_CONFIG)
    except (ValueError, RuntimeError, OSError) as e:
        return label.format("!", f"Not applied: {e}")
    except Exception as e:  # D-Bus errors from the keyring
        return label.format("!", f"Not applied: the keyring refused ({e}).")
    return label.format("✔", f"{len(accounts)} account(s) restored; they're signed in when Mailspring starts.")


def mailspring_section() -> dict:
    """This account's Mailspring accounts, saved logins and token, as a mailspring: section."""
    import base64
    star = load_mailspring_config().get("*") or {}
    accounts = star.get("accounts") or []
    data = (star.get("credentials") or {}).get("data") if isinstance(star.get("credentials"), dict) else None
    if not accounts or not data:
        raise RuntimeError("Mailspring has no accounts here to export.")
    token = read_portal_token()
    if not token:
        raise RuntimeError("Mailspring's key isn't in the keyring.")
    return {
        "accounts": [{k: a[k] for k in MAILSPRING_ACCOUNT_KEYS if k in a} for a in accounts],
        "credentials": base64.b64encode(bytes(data)).decode(),
        "portal_token": base64.b64encode(token).decode(),
    }


# --- Commands ---

def read_source(source_str: str) -> bytes:
    """The bytes of a config from an https:// URL or a file path (exits on failure)."""
    if source_str.startswith("http://"):
        print("[ERROR] Refusing to download configuration over plain http://. Use an https:// URL.")
        sys.exit(1)
    if source_str.startswith("https://"):
        print(f"Downloading configuration from: {source_str}...")
        try:
            req = urllib.request.Request(source_str, headers={"User-Agent": "RedFoxOS-redfox-config/1.0"})
            with urllib.request.urlopen(req, timeout=15) as resp:
                return resp.read()
        except Exception as e:
            print(f"[ERROR] Failed to download configuration: {e}")
            sys.exit(1)
    p = Path(unquote(source_str)).expanduser()
    if not p.exists():
        print(f"[ERROR] File not found: {p}")
        sys.exit(1)
    return p.read_bytes()


def cmd_setup(args):
    """Run interactive setup or ingest configuration from a source."""
    source = getattr(args, "source", None)
    raw = b""

    # 1. Non-interactive pipe (e.g. cat config.yaml | redfox-config setup)
    if not sys.stdin.isatty() and not source:
        raw = sys.stdin.buffer.read()
        if not raw.strip():
            print("[INFO] Empty input received. Setup skipped.")
            return

    # 2. Source argument provided (URL or file)
    elif source:
        raw = read_source(source.strip())

    # 3. Interactive terminal prompt
    else:
        import shutil
        can_pick = graphical_session() and shutil.which("zenity") is not None
        print("=================================================================")
        print("                  RedFoxOS Configuration Setup                   ")
        print("=================================================================")
        if USER_CONFIG_PATH.exists():
            print(f"[!] Existing configuration found: {USER_CONFIG_PATH}")
            print("    (To edit existing values without overwriting, exit and run: redfox-config edit)")
            print("    Pasting a new configuration will replace the existing file (backup saved to .bak).\n")
        print("Enter an https:// URL, a file path, or paste your YAML configuration below.")
        print("An age-encrypted config (age -p) works too: you'll be asked for its passphrase.")
        if can_pick:
            print("To choose a file instead, type F and press Enter.")
        print("(When pasting, press Enter twice on empty lines or Ctrl+D when finished. Press Enter now to skip):\n")

        lines = []
        try:
            first_line = input().strip()
            if not first_line:
                print("\n[INFO] Configuration setup skipped. Using RedFoxOS defaults.")
                return

            if can_pick and first_line in ("f", "F"):
                chosen = pick_file()
                if not chosen:
                    print("\n[INFO] No file chosen. Configuration unchanged.")
                    return
                args.source = chosen
                cmd_setup(args)
                return

            # Check if user entered a URL or file path on the first line
            if first_line.startswith("http://") or first_line.startswith("https://"):
                args.source = first_line
                cmd_setup(args)
                return

            potential_file = Path(unquote(first_line)).expanduser()
            if potential_file.exists() and potential_file.is_file():
                args.source = str(potential_file)
                cmd_setup(args)
                return

            # User is pasting YAML directly. Single blank lines are kept (YAML often
            # has them between sections); two empty lines in a row end the paste.
            # A pasted armored age file ends at its END line.
            lines.append(first_line)
            armored = first_line.encode() == AGE_ARMOR_BEGIN
            while True:
                line = input()
                if line == "" and lines and lines[-1] == "":
                    break
                lines.append(line)
                if armored and line.strip() == AGE_ARMOR_END:
                    break
        except EOFError:
            pass

        raw = "\n".join(lines).strip().encode("utf-8")

    if raw and is_encrypted(raw):
        try:
            # Binary age data is passed as is; an armored one is tidied (pasted text).
            raw = decrypt_config(raw if raw.startswith(AGE_BINARY_HEADER) else raw.strip() + b"\n")
        except RuntimeError as e:
            print(f"[ERROR] {e} Configuration unchanged.")
            sys.exit(1)
        if raw is None:
            print("[INFO] No passphrase entered. Configuration unchanged.")
            return
        print("[OK] Decrypted.")

    try:
        raw_content = raw.decode("utf-8").strip()
    except UnicodeDecodeError:
        print("\n[ERROR] This isn't a text config or an age-encrypted one. Configuration unchanged.")
        sys.exit(1)

    if not raw_content:
        print("[INFO] No content provided. Configuration unchanged.")
        return

    # Validate YAML structure
    try:
        parsed = parse_yaml_text(raw_content)
    except Exception as e:
        print(f"\n[ERROR] Invalid YAML format: {e}")
        print("Please check your configuration syntax and try again.")
        sys.exit(1)

    save_config_text(raw_content)
    print(f"\n[OK] Configuration validated and saved to {USER_CONFIG_PATH} (mode 0600).")

    # Display module summary
    print("\nEvaluating modules:")
    if section(parsed, "nordvpn").get("token"):
        print("  [✔] NordVPN Setup   : Access token found -> Ready for WireGuard provisioning.")
    else:
        print("  [―] NordVPN Setup   : No token configured -> Using standard network connection.")

    machines = section(parsed, "machines")
    if machines:
        print(f"  [✔] Machines        : {len(machines)} machine(s) registered.")
        ident, entry = find_machine(parsed)
        if ident:
            hostname = entry.get("hostname") or "(unchanged)"
            quirks = ", ".join(as_list(entry.get("quirks"))) or "none"
            print(f"      • This device matches '{ident}' -> hostname: {hostname}, quirks: {quirks}")
        else:
            ids = get_hardware_identifiers()
            dev_desc = ids[0] if ids else "this device"
            print(f"      • Detected hardware ({dev_desc}) -> No machine entry for this device.")
            print("        (The DMI serial may need sudo to read; bootstrap recipes pass it in automatically.)")
    else:
        print("  [―] Machines        : No machine-specific settings registered.")
    for line in (apply_profile_picture(parsed), apply_mailspring(parsed)):
        if line:
            print(line)
    warn_legacy_quirks(parsed)

    print("\n🎉 RedFoxOS configuration setup complete!")


def cmd_machine(args):
    """Print a field of this device's `machines:` entry (lists print one item per line)."""
    cfg = load_yaml(USER_CONFIG_PATH)
    warn_legacy_quirks(cfg)
    ident, entry = find_machine(cfg, getattr(args, "id", None))
    if not ident:
        sys.exit(1)
    if not args.field:
        print(ident)
        return
    values = as_list(entry.get(args.field))
    if not values:
        sys.exit(1)
    print("\n".join(values))


def cmd_get(args):
    """Retrieve a specific nested key from config.yaml (e.g. nordvpn.token)."""
    cfg = load_yaml(USER_CONFIG_PATH)
    key_path = args.key.split(".")
    val = cfg
    for k in key_path:
        if isinstance(val, dict) and k in val:
            val = val[k]
        else:
            sys.exit(1)

    # Treat empty values (e.g. "token:" with nothing after it) as unset
    if val is None or val == "":
        sys.exit(1)

    if isinstance(val, (dict, list)):
        import yaml
        print(yaml.dump(val, default_flow_style=False).strip())
    else:
        print(str(val))


def cmd_show(args):
    """Display active config with sensitive tokens masked."""
    if not USER_CONFIG_PATH.exists():
        print(f"No configuration file found at {USER_CONFIG_PATH}.")
        print("Run 'redfox-config setup' to configure your system.")
        return

    cfg = load_yaml(USER_CONFIG_PATH)
    if not cfg:
        print(f"{USER_CONFIG_PATH} is empty.")
        return

    # Mask token
    if section(cfg, "nordvpn").get("token"):
        tok = str(cfg["nordvpn"]["token"])
        if len(tok) > 8:
            cfg["nordvpn"]["token"] = tok[:4] + "..." + tok[-4:]
        else:
            cfg["nordvpn"]["token"] = "********"
    for key in ("credentials", "portal_token"):
        if section(cfg, "mailspring").get(key):
            cfg["mailspring"][key] = f"(hidden, {len(str(cfg['mailspring'][key]))} characters)"
    if cfg.get("profile_picture"):
        cfg["profile_picture"] = f"(an image, {len(str(cfg['profile_picture']))} characters)"

    import yaml
    print(yaml.dump(cfg, default_flow_style=False, sort_keys=False).strip())


def cmd_mailspring_export(args):
    """Print this account's Mailspring accounts as a mailspring: section for config.yaml."""
    import yaml
    try:
        sec = mailspring_section()
    except RuntimeError as e:
        print(f"[ERROR] {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:  # D-Bus errors from the keyring
        print(f"[ERROR] The keyring refused: {e}", file=sys.stderr)
        sys.exit(1)
    print("# Your Mailspring accounts and saved logins. Add this to your config.yaml and keep it secret.")
    print(yaml.safe_dump({"mailspring": sec}, default_flow_style=False, sort_keys=False, width=100000).strip())


def cmd_edit(args):
    """Open config.yaml in preferred text editor."""
    USER_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not USER_CONFIG_PATH.exists():
        USER_CONFIG_PATH.touch(mode=0o600)

    editor = os.environ.get("EDITOR") or "nano"
    # Fallback to desktop editor if in graphical session and editor is nano
    if os.environ.get("DISPLAY") and not os.environ.get("EDITOR"):
        for ed in ["gnome-text-editor", "gedit", "code"]:
            if subprocess.run(["which", ed], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                editor = ed
                break

    subprocess.run([editor, str(USER_CONFIG_PATH)])


def cmd_reset(args):
    """Safely reset and remove configuration."""
    if not USER_CONFIG_DIR.exists():
        print("No RedFoxOS configuration directory found.")
        return

    if not args.yes:
        ans = input(f"WARNING: This will permanently delete {USER_CONFIG_DIR} and all saved configurations.\nAre you sure? [y/N]: ").strip().lower()
        if ans not in ("y", "yes"):
            print("Operation aborted.")
            return

    import shutil
    shutil.rmtree(USER_CONFIG_DIR, ignore_errors=True)
    print(f"[SUCCESS] Deleted {USER_CONFIG_DIR}. Run 'redfox-config setup' to reconfigure.")


def build_parser():
    main_description = """Unified Declarative Configuration Engine for RedFoxOS.

COMMANDS:
    setup [SOURCE]    Ingest and validate configuration (paste, local file, or https URL;
                      plain YAML or encrypted with age -p)
    machine [FIELD]   Print this device's machines entry (e.g. 'hostname', 'quirks')
    get <KEY>         Retrieve a specific configuration value (e.g. 'nordvpn.token')
    show              Display active configuration with tokens masked
    edit              Open ~/.config/redfox/config.yaml in preferred editor
    reset [-y]        Permanently delete ~/.config/redfox configuration
    mailspring-export Print your Mailspring accounts and saved logins as a mailspring: section"""

    main_epilog = """EXAMPLES:
    redfox-config setup              # Interactive prompt (paste YAML, enter URL or file)
    redfox-config setup mycfg.yaml   # Ingest directly from local file
    redfox-config machine quirks     # Print this device's quirk recipes, one per line
    redfox-config machine hostname   # Print this device's configured hostname
    redfox-config get nordvpn.token  # Print configured NordVPN access token
    redfox-config show               # Display configuration with secrets masked"""

    parser = argparse.ArgumentParser(
        prog="redfox-config",
        usage="redfox-config <COMMAND> [OPTIONS]",
        description=main_description,
        epilog=main_epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    subparsers = parser.add_subparsers(dest="command", required=False)

    # setup
    p_setup = subparsers.add_parser(
        "setup",
        usage="redfox-config setup [SOURCE]",
        description="Ingest and validate RedFoxOS configuration from a URL, local file, or interactive paste. "
                    "A config encrypted with age -p is decrypted after its passphrase (no temporary files) "
                    "and saved as the usual plain config, readable only by you.",
        help="Setup system configuration (paste, file, or URL)"
    )
    p_setup.add_argument("source", nargs="?", help="Optional file path or URL to configuration YAML")

    # machine
    p_machine = subparsers.add_parser(
        "machine",
        usage="redfox-config machine [FIELD] [--id ID]",
        description="Match this device (DMI serial, board version, or model) against the 'machines' section. "
                    "Without FIELD, prints the matched machine key. Exits 1 if there is no match or no value.",
        help="Print a field from this device's machines entry"
    )
    p_machine.add_argument("field", nargs="?", help="Field to print (e.g. 'hostname', 'quirks')")
    p_machine.add_argument("--id", help="Identifier to try first (e.g. a serial read with sudo)")

    # get
    p_get = subparsers.add_parser(
        "get",
        usage="redfox-config get <KEY>",
        description="Retrieve a specific value from configuration (e.g. 'nordvpn.token').",
        help="Get a specific configuration value by key"
    )
    p_get.add_argument("key", help="Key path (e.g. 'nordvpn.token')")

    # show
    subparsers.add_parser(
        "show",
        description="Display active configuration with tokens masked.",
        help="Show active configuration"
    )

    # edit
    subparsers.add_parser(
        "edit",
        description="Open ~/.config/redfox/config.yaml in preferred editor.",
        help="Edit configuration file"
    )

    # reset
    p_reset = subparsers.add_parser(
        "reset",
        description="Permanently delete ~/.config/redfox directory.",
        help="Reset configuration"
    )
    p_reset.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")

    # mailspring-export
    subparsers.add_parser(
        "mailspring-export",
        description="Print this account's Mailspring accounts, their saved logins and the key they are "
                    "encrypted with, as a mailspring: section for config.yaml. setup restores them, signed in, "
                    "before Mailspring's first start on a new install.",
        help="Export Mailspring accounts for config.yaml"
    )

    # Remove automatic positional arguments group to prevent duplicate command listing
    for grp in parser._action_groups:
        if grp.title == "positional arguments":
            parser._action_groups.remove(grp)
            break

    return parser, subparsers


def main():
    parser, subparsers = build_parser()

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()

    try:
        if args.command == "setup":
            cmd_setup(args)
        elif args.command == "machine":
            cmd_machine(args)
        elif args.command == "get":
            cmd_get(args)
        elif args.command == "show":
            cmd_show(args)
        elif args.command == "edit":
            cmd_edit(args)
        elif args.command == "mailspring-export":
            cmd_mailspring_export(args)
        elif args.command == "reset":
            cmd_reset(args)
    except KeyboardInterrupt:
        print("\nOperation cancelled by user.")
        sys.exit(130)
    except Exception as e:
        print(f"\n[ERROR] {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
