#!/usr/bin/bash
# redfox-autostart: start apps in the tray at login, one app at a time.
#
#   redfox-autostart list [--json]   the apps that can, installed or not, on or off
#   redfox-autostart on APP...       start APP in the tray at login
#   redfox-autostart off APP...      stop doing that
#
# APP is a Flatpak id: org.signal.Signal or net.cozic.joplin_desktop.
# Opened any other way, the apps open normally. RedFox Hub (Settings) and the
# configure-autostart-tray recipe are front ends to this.
set -euo pipefail

AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
KNOWN=(org.signal.Signal net.cozic.joplin_desktop)

name_of() {
    case "$1" in
        org.signal.Signal) echo Signal ;;
        net.cozic.joplin_desktop) echo Joplin ;;
        *) return 1 ;;
    esac
}

installed() { flatpak info "$1" >/dev/null 2>&1; }

exported() {
    for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share/applications" /var/lib/flatpak/exports/share/applications; do
        if [ -f "$dir/$1.desktop" ]; then echo "$dir/$1.desktop"; return 0; fi
    done
    return 0
}

# The Flatpak's own launcher, used as TryExec: if the app is uninstalled
# later, GNOME skips these entries instead of failing or showing a broken icon.
launcher() {
    for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/bin" /var/lib/flatpak/exports/bin; do
        if [ -x "$dir/$1" ]; then echo "$dir/$1"; return 0; fi
    done
    echo "/var/lib/flatpak/exports/bin/$1"
}

is_on() {
    case "$1" in
        org.signal.Signal) grep -qs 'start-in-tray' "$AUTOSTART/org.signal.Signal.desktop" ;;
        net.cozic.joplin_desktop) grep -qs 'redfox-joplin-launch' "$AUTOSTART/net.cozic.joplin_desktop.desktop" ;;
    esac
}

turn_on() {
    local app="$1"
    if ! installed "$app"; then
        echo "$(name_of "$app") isn't installed; skipping it."
        return 0
    fi
    mkdir -p "$AUTOSTART"
    case "$app" in
        org.signal.Signal)
            printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Signal' 'Icon=org.signal.Signal' \
                "TryExec=$(launcher org.signal.Signal)" \
                'Exec=flatpak run org.signal.Signal --use-tray-icon --start-in-tray' \
                'X-Flatpak=org.signal.Signal' 'X-GNOME-Autostart-Delay=5' > "$AUTOSTART/org.signal.Signal.desktop"
            ;;
        net.cozic.joplin_desktop)
            printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Joplin' 'Icon=net.cozic.joplin_desktop' \
                "TryExec=$(launcher net.cozic.joplin_desktop)" \
                'Exec=/usr/libexec/redfox-joplin-launch --tray' \
                'X-Flatpak=net.cozic.joplin_desktop' 'X-GNOME-Autostart-Delay=5' > "$AUTOSTART/net.cozic.joplin_desktop.desktop"
            # Joplin has no tray flag, so its normal launcher goes through the same
            # wrapper, which switches "start minimised" back off before it starts.
            local src
            src="$(exported net.cozic.joplin_desktop)"
            if [ -n "$src" ]; then
                mkdir -p "$APPS"
                sed -E -e '/^TryExec=/d' -e 's|^Exec=.*|Exec=/usr/libexec/redfox-joplin-launch %u|' \
                    -e "/^\[Desktop Entry\]/a TryExec=$(launcher net.cozic.joplin_desktop)" \
                    "$src" > "$APPS/net.cozic.joplin_desktop.desktop"
            fi
            ;;
    esac
    echo "$(name_of "$app") will start in the tray at login."
}

turn_off() {
    local app="$1"
    case "$app" in
        org.signal.Signal)
            grep -qs 'start-in-tray' "$AUTOSTART/org.signal.Signal.desktop" &&
                rm -f -- "$AUTOSTART/org.signal.Signal.desktop"
            ;;
        net.cozic.joplin_desktop)
            grep -qs 'redfox-joplin-launch' "$AUTOSTART/net.cozic.joplin_desktop.desktop" &&
                rm -f -- "$AUTOSTART/net.cozic.joplin_desktop.desktop"
            grep -qs 'redfox-joplin-launch' "$APPS/net.cozic.joplin_desktop.desktop" &&
                rm -f -- "$APPS/net.cozic.joplin_desktop.desktop"
            ;;
    esac
    echo "$(name_of "$app") no longer starts at login."
}

check_app() {
    name_of "$1" >/dev/null || { echo "Unknown app '$1'. Known: ${KNOWN[*]}" >&2; exit 2; }
}

case "${1:-list}" in
    list)
        if [ "${2:-}" = --json ]; then
            first=true
            printf '{"version":1,"apps":['
            for app in "${KNOWN[@]}"; do
                $first || printf ','
                first=false
                printf '{"id":"%s","name":"%s","installed":%s,"on":%s}' "$app" "$(name_of "$app")" \
                    "$(installed "$app" && echo true || echo false)" \
                    "$(is_on "$app" && echo true || echo false)"
            done
            printf ']}\n'
        else
            for app in "${KNOWN[@]}"; do
                printf '%-8s %-26s %s\n' "$(is_on "$app" && echo on || echo off)" "$app" \
                    "$(installed "$app" && echo installed || echo 'not installed')"
            done
        fi
        ;;
    on|off)
        [ $# -ge 2 ] || { echo "Usage: redfox-autostart $1 APP..." >&2; exit 2; }
        verb="$1"; shift
        for app in "$@"; do
            check_app "$app"
            if [ "$verb" = on ]; then turn_on "$app"; else turn_off "$app"; fi
        done
        ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "Unknown command '$1'. See --help." >&2; exit 2 ;;
esac
