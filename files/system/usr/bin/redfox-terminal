#!/usr/bin/bash
# redfox-terminal: the two optional terminal extras, each on or off by itself.
#
#   redfox-terminal status [--json]   {"prompt": true|false, "tools": true|false,
#                                      "theme": "<id>"}
#   redfox-terminal prompt on|off|status
#                                     the styled prompt: Starship, in the theme
#                                     chosen below (RedFox's own unless another
#                                     is chosen). Looks only; commands are
#                                     unchanged.
#   redfox-terminal prompt themes [--json]
#                                     the themes: RedFox's own, Starship's
#                                     default and Starship's official presets
#                                     ({"on", "current", "own_config",
#                                       "themes": [{"id", "name", "nerd_font"}]})
#   redfox-terminal prompt theme <id>
#                                     use that theme (and turn the prompt on)
#   redfox-terminal tools on|off|status
#                                     modern command-line tools: eza for ls,
#                                     ugrep for grep, atuin for Ctrl+R history,
#                                     zoxide's z (Bazzite's "bling").
#
# Both are set in your shells' startup files (bash, zsh and fish), so they work
# in any terminal. Turning one off removes its lines; the Homebrew packages
# stay installed. RedFox Hub's Settings › Terminal uses this.
set -euo pipefail

BREW=/home/linuxbrew/.linuxbrew/bin/brew
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
TOOLS=(eza ugrep atuin zoxide bat fd ripgrep)
# The prompt themes (id, name, file, uses Nerd Font symbols), and the one
# chosen. /etc/profile.d/redfox-starship.sh (and its fish twin) read the same.
THEMES="${REDFOX_STARSHIP_THEMES:-/usr/share/redfox/starship/themes/themes.tsv}"
THEME_FILE="$CONFIG/redfox/starship-theme"

# shell name, startup file
rc_files() {
    echo "bash $HOME/.bashrc"
    command -v zsh >/dev/null 2>&1 && echo "zsh ${ZDOTDIR:-$HOME}/.zshrc"
    command -v fish >/dev/null 2>&1 && echo "fish $CONFIG/fish/config.fish"
    return 0
}

begin_mark() { echo "# >>> redfox-terminal $1 >>>"; }
end_mark() { echo "# <<< redfox-terminal $1 <<<"; }

block() { # $1 = prompt|tools, $2 = shell
    case "$1:$2" in
        prompt:fish) echo 'command -q starship; and starship init fish | source' ;;
        prompt:*) echo "command -v starship >/dev/null 2>&1 && eval \"\$(starship init $2)\"" ;;
        tools:fish) echo 'test -f /usr/share/bazzite-cli/bling.fish; and source /usr/share/bazzite-cli/bling.fish' ;;
        tools:*) echo 'test -f /usr/share/bazzite-cli/bling.sh && source /usr/share/bazzite-cli/bling.sh' ;;
    esac
}

remove_block() { # $1 = prompt|tools, $2 = file
    [ -f "$2" ] || return 0
    sed -i "/^$(begin_mark "$1")\$/,/^$(end_mark "$1")\$/d" "$2"
}

add_block() { # $1 = prompt|tools, $2 = shell, $3 = file
    mkdir -p "$(dirname "$3")"
    touch "$3"
    remove_block "$1" "$3"
    { begin_mark "$1"; block "$1" "$2"; end_mark "$1"; } >> "$3"
}

is_on() { # $1 = prompt|tools
    grep -qxF "$(begin_mark "$1")" "$HOME/.bashrc" 2>/dev/null
}

brew_install() {
    if [ ! -x "$BREW" ]; then
        echo "redfox-terminal: Homebrew isn't set up yet" >&2
        exit 1
    fi
    local missing=()
    for pkg in "$@"; do
        "$BREW" list --formula "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        echo "Installing ${missing[*]} with Homebrew..."
        "$BREW" install "${missing[@]}"
    fi
}

switch() { # $1 = prompt|tools, $2 = on|off
    if [ "$2" = on ]; then
        if [ "$1" = prompt ]; then brew_install starship; else brew_install "${TOOLS[@]}"; fi
        while read -r shell file; do add_block "$1" "$shell" "$file"; done < <(rc_files)
        echo "Turned on. New terminal windows show it."
    else
        while read -r _ file; do remove_block "$1" "$file"; done < <(rc_files)
        echo "Turned off. New terminal windows are back to plain."
    fi
}

themes() { grep -v '^#' "$THEMES"; }

current_theme() {
    local id=""
    [ -f "$THEME_FILE" ] && id=$(head -n1 "$THEME_FILE")
    if [ -n "$id" ] && themes | cut -f1 | grep -qxF "$id"; then echo "$id"; else echo redfox; fi
}

json_string() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

list_themes() { # $1 = --json or empty
    local current; current=$(current_theme)
    if [ "${1:-}" = --json ]; then
        local first=1
        printf '{"on": %s, "current": %s, "own_config": %s, "themes": [' \
            "$(is_on prompt && echo true || echo false)" "$(json_string "$current")" \
            "$([ -e "$CONFIG/starship.toml" ] && echo true || echo false)"
        while IFS=$'\t' read -r id name _file nerd; do
            [ $first = 1 ] || printf ', '
            first=0
            printf '{"id": %s, "name": %s, "nerd_font": %s}' "$(json_string "$id")" \
                "$(json_string "$name")" "$([ "$nerd" = yes ] && echo true || echo false)"
        done < <(themes)
        printf ']}\n'
    else
        while IFS=$'\t' read -r id name _file nerd; do
            mark=" "; [ "$id" = "$current" ] && mark="*"
            note=""; [ "$nerd" = yes ] && note=" (Nerd Font symbols)"
            printf '%s %-22s %s%s\n' "$mark" "$id" "$name" "$note"
        done < <(themes)
    fi
}

set_theme() { # $1 = id
    if ! themes | cut -f1 | grep -qxF "$1"; then
        echo "redfox-terminal: no prompt theme \"$1\" (see: redfox-terminal prompt themes)" >&2
        exit 2
    fi
    mkdir -p "$(dirname "$THEME_FILE")"
    echo "$1" > "$THEME_FILE"
    if [ -e "$CONFIG/starship.toml" ]; then
        echo "Note: your own $CONFIG/starship.toml is used instead of a theme while it exists."
    fi
    if is_on prompt; then
        echo "Theme set. New terminal windows show it."
    else
        switch prompt on
    fi
}

case "${1:-}" in
    status)
        p=false t=false
        is_on prompt && p=true
        is_on tools && t=true
        if [ "${2:-}" = --json ]; then
            printf '{"prompt": %s, "tools": %s, "theme": %s}\n' "$p" "$t" "$(json_string "$(current_theme)")"
        else
            echo "prompt: $p"
            echo "tools: $t"
            echo "theme: $(current_theme)"
        fi
        ;;
    prompt)
        case "${2:-}" in
            on|off) switch prompt "$2" ;;
            status) if is_on prompt; then echo on; else echo off; fi ;;
            themes) list_themes "${3:-}" ;;
            theme) [ -n "${3:-}" ] || { echo "Usage: redfox-terminal prompt theme <id>" >&2; exit 2; }
                   set_theme "$3" ;;
            *) echo "Usage: redfox-terminal prompt on|off|status|themes|theme <id>" >&2; exit 2 ;;
        esac
        ;;
    tools)
        case "${2:-}" in
            on|off) switch "$1" "$2" ;;
            status) if is_on "$1"; then echo on; else echo off; fi ;;
            *) echo "Usage: redfox-terminal $1 on|off|status" >&2; exit 2 ;;
        esac
        ;;
    *)
        sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
