#!/usr/bin/env bash
set -euo pipefail

# Registry of RedFox Labs Flatpak applications: APP_ID -> REPO_SLUG
declare -A REDFOX_APPS=(
    ["tech.redfoxlabs.Pianola"]="snakeeyes021/pianola"
)

TAG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/redfox-apps"
mkdir -p "$TAG_DIR" 2>/dev/null || true

install_or_update_app() {
    local APP_ID="$1"
    local REPO="$2"
    local FORCE="${3:-false}"
    local TAG_FILE="$TAG_DIR/${APP_ID}.tag"

    echo "=== Checking RedFox App: $APP_ID ==="

    # Fetch latest release info from GitHub API
    local LATEST_RELEASE
    LATEST_RELEASE=$(curl -sL "https://api.github.com/repos/${REPO}/releases/latest" || true)

    local LATEST_TAG
    LATEST_TAG=$(echo "$LATEST_RELEASE" | jq -r '.tag_name // empty' 2>/dev/null || true)

    if [ -z "$LATEST_TAG" ] || [ "$LATEST_TAG" == "null" ]; then
        echo "   ⚠️  Could not fetch release info for $REPO. Attempting direct bundle download..."
        LATEST_TAG="latest"
    fi

    local CURRENT_TAG=""
    if [ -f "$TAG_FILE" ]; then
        CURRENT_TAG=$(cat "$TAG_FILE" 2>/dev/null || true)
    fi

    # Check if already installed
    local IS_INSTALLED=false
    if flatpak info --user "$APP_ID" &>/dev/null; then
        IS_INSTALLED=true
    fi

    # If tag file doesn't exist yet, inspect installed Flatpak metadata to avoid redundant downloads
    if [ "$IS_INSTALLED" = true ] && [ -z "$CURRENT_TAG" ]; then
        local INSTALLED_VER
        INSTALLED_VER=$(flatpak info --user "$APP_ID" 2>/dev/null | awk '/^ *Version:/{print $2}' || true)
        if [ -n "$INSTALLED_VER" ] && [ "$LATEST_TAG" != "latest" ]; then
            if [ "$INSTALLED_VER" = "$LATEST_TAG" ] || [ "$INSTALLED_VER" = "${LATEST_TAG#v}" ] || [ "v$INSTALLED_VER" = "$LATEST_TAG" ]; then
                CURRENT_TAG="$LATEST_TAG"
                echo "$CURRENT_TAG" > "$TAG_FILE" 2>/dev/null || true
            fi
        fi
    fi

    if [ "$IS_INSTALLED" = true ] && [ "$FORCE" = false ] && [ -n "$CURRENT_TAG" ] && [ "$CURRENT_TAG" = "$LATEST_TAG" ] && [ "$LATEST_TAG" != "latest" ]; then
        echo "   [OK] $APP_ID is already up to date ($CURRENT_TAG)."
        return 0
    fi

    if [ "$IS_INSTALLED" = true ]; then
        echo "   Updating $APP_ID (${CURRENT_TAG:-unknown} -> $LATEST_TAG)..."
    else
        echo "   Installing $APP_ID ($LATEST_TAG)..."
    fi

    local DOWNLOAD_URL="https://github.com/${REPO}/releases/latest/download/${APP_ID}.flatpak"
    local TEMP_BUNDLE
    TEMP_BUNDLE=$(mktemp --suffix=.flatpak)
    trap 'rm -f "$TEMP_BUNDLE"' RETURN

    echo "   Downloading from $DOWNLOAD_URL..."
    if ! curl -sL -f "$DOWNLOAD_URL" -o "$TEMP_BUNDLE"; then
        echo "   ❌ Download failed for $APP_ID from $DOWNLOAD_URL"
        return 1
    fi

    echo "   Installing Flatpak bundle..."
    local INSTALL_OUTPUT
    if ! INSTALL_OUTPUT=$(flatpak install --user -y --noninteractive --or-update "$TEMP_BUNDLE" 2>&1); then
        if echo "$INSTALL_OUTPUT" | grep -qi "already installed"; then
            echo "   [OK] $APP_ID is already installed and up to date."
        else
            echo "   ❌ Installation failed for $APP_ID:"
            echo "$INSTALL_OUTPUT"
            return 1
        fi
    fi

    if [ "$LATEST_TAG" != "latest" ]; then
        echo "$LATEST_TAG" > "$TAG_FILE"
    fi

    echo "   [OK] $APP_ID installed successfully ($LATEST_TAG)."
    return 0
}

# --- Main Dispatch ---
TARGET_APP="${1:-}"

if [ -n "$TARGET_APP" ]; then
    # Specific app requested (e.g. from `just install-pianola`)
    if [[ -v "REDFOX_APPS[$TARGET_APP]" ]]; then
        install_or_update_app "$TARGET_APP" "${REDFOX_APPS[$TARGET_APP]}" true
    else
        echo "Error: Unknown RedFox application '$TARGET_APP'."
        echo "Known apps: ${!REDFOX_APPS[*]}"
        exit 1
    fi
else
    # Automatic update run (e.g. from Topgrade)
    echo "=== Updating RedFox Labs Applications ==="
    UPDATED_ANY=false

    for APP_ID in "${!REDFOX_APPS[@]}"; do
        # Only update apps that are already installed on this user's machine
        if flatpak info --user "$APP_ID" &>/dev/null; then
            UPDATED_ANY=true
            REPO="${REDFOX_APPS[$APP_ID]}"
            install_or_update_app "$APP_ID" "$REPO" false || {
                echo "   ⚠️ Warning: Could not update $APP_ID during this cycle."
            }
        fi
    done

    if [ "$UPDATED_ANY" = false ]; then
        echo "No RedFox Labs applications are currently installed. Nothing to update."
    else
        echo "=== RedFox Labs Applications update check complete ==="
    fi
    exit 0
fi
