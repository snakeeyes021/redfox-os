#!/usr/bin/env python3
"""redfox-updates: the state of RedFoxOS's updates, and update now.

RedFoxOS has two updaters that wait for each other
(/usr/libexec/redfox-wait-for-system-update):

- uupd, the automatic one: uupd.timer runs it daily (and at startup if a run
  was missed). It updates the system image, Flatpaks, Homebrew and distrobox;
  a new image is applied at the next restart.
- topgrade, "update now": the same things plus firmware and RedFox's own
  apps, run with RedFox's /usr/share/ublue-os/topgrade.toml.

Commands:
  status [--json]     automatic updates, last run, restart pending, channel,
                      and the booted, staged and rollback systems
  now                 update everything now (topgrade), then report
  auto on|off         turn the automatic updates on or off (asks for a password)
  auto at HH:00       run them at that hour every day instead of the default
                      (04:00); `auto at default` goes back (asks for a password)
  restart             restart to finish an update

RedFox Hub (Updates) is a front end to this command.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

VERSION = "1"
TOPGRADE_CONFIG = "/usr/share/ublue-os/topgrade.toml"
IMAGE_INFO = Path("/usr/share/ublue-os/image-info.json")
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "redfox"
LAST_MANUAL = STATE_DIR / "last-update-now.json"
# Written by /usr/libexec/redfox-updates-auto when an hour is chosen
TIME_DROPIN = Path(os.environ.get("REDFOX_UUPD_DROPIN_DIR", "/etc/systemd/system/uupd.timer.d")) \
    / "50-redfox-time.conf"
HOUR = re.compile(r"(?:[01]\d|2[0-3]):00")


def sh(*argv):
    try:
        proc = subprocess.run(argv, capture_output=True, text=True,
                              stdin=subprocess.DEVNULL)
    except OSError:
        return 127, ""
    return proc.returncode, proc.stdout


def unit_props(unit, *props):
    _, out = sh("systemctl", "show", unit, "--timestamp=unix",
                "-p", ",".join(props))
    values = {}
    for line in out.splitlines():
        key, _, value = line.partition("=")
        values[key] = value
    return values


def unix(value):
    """systemd's '@1730000000' (with --timestamp=unix) to an int, or None."""
    match = re.fullmatch(r"@(\d+)", (value or "").strip())
    return int(match.group(1)) if match and int(match.group(1)) > 0 else None


def short_ref(ref):
    """ostree-image-signed:docker://ghcr.io/x/redfox-os:latest -> redfox-os:latest"""
    ref = re.sub(r"^ostree-[a-z-]+(:[a-z-]+)?:(docker://)?", "", ref or "")
    return ref.rsplit("/", 1)[-1]


def channel_of(ref):
    tag = short_ref(ref).rpartition(":")[2]
    if tag == "unstable" or tag.startswith("br-unstable-"):
        return "unstable"
    if tag in ("latest", "stable", ""):
        return "latest"
    # A pinned build: a date (stable) or a commit tag; it doesn't follow a channel.
    return "pinned"


def calendar_time(timers_calendar):
    """The time of day in uupd.timer's TimersCalendar, e.g.
    '{ OnCalendar=*-*-* 21:00:00 ; next_elapse=... }' -> '21:00', or None."""
    match = re.search(r"OnCalendar=\S*\s+(\d{1,2}):(\d{2})(?::\d{2})?", timers_calendar or "")
    return f"{int(match.group(1)):02d}:{match.group(2)}" if match else None


def deployment(d):
    if not d:
        return None
    ref = d.get("container-image-reference", "")
    return {
        "ref": ref,
        "image": short_ref(ref).partition(":")[0] or None,
        "tag": short_ref(ref).rpartition(":")[2] or None,
        "channel": channel_of(ref),
        "version": d.get("version"),
        "timestamp": d.get("timestamp"),
        "pinned": bool(d.get("pinned")),
    }


def status():
    rc, out = sh("rpm-ostree", "status", "--json")
    try:
        ostree = json.loads(out) if rc == 0 else {}
    except ValueError:
        ostree = {}
    deployments = ostree.get("deployments", [])
    booted = next((d for d in deployments if d.get("booted")), None)
    staged = next((d for d in deployments if d.get("staged")), None)
    rollback = next((d for d in deployments
                     if not d.get("booted") and not d.get("staged")), None)
    # A finished update that is waiting for a restart: a staged deployment,
    # or (after `rpm-ostree rollback`) a different first deployment.
    pending = bool(staged) or bool(deployments and not deployments[0].get("booted"))
    # What the restart brings: a new system (staged), or, after a rollback,
    # the one before (an older deployment moved to the front).
    restart_for = "update" if staged else ("rollback" if pending else None)
    next_boot = staged or (deployments[0] if pending else None)

    timer = unit_props("uupd.timer", "UnitFileState", "ActiveState",
                       "LastTriggerUSec", "NextElapseUSecRealtime", "TimersCalendar")
    service = unit_props("uupd.service", "ActiveState", "Result",
                         "ExecMainExitTimestamp", "ExecMainStartTimestamp")
    auto_running = service.get("ActiveState") in ("active", "activating")
    _, top = sh("pgrep", "-x", "topgrade")
    manual = None
    try:
        manual = json.loads(LAST_MANUAL.read_text())
    except (OSError, ValueError):
        pass

    return {
        "version": 1,
        "auto": {
            "enabled": timer.get("UnitFileState") == "enabled",
            "running": auto_running,
            "next": unix(timer.get("NextElapseUSecRealtime")),
            # The hour it runs (HH:MM), and whether that's the base image's own time
            "at": calendar_time(timer.get("TimersCalendar")),
            "at_default": not TIME_DROPIN.exists(),
            "last_run": unix(service.get("ExecMainExitTimestamp"))
                        or unix(timer.get("LastTriggerUSec")),
            "last_result": service.get("Result") or None,
        },
        "now": {
            "running": bool(top.strip()),
            "last_run": manual.get("finished") if manual else None,
            "last_ok": manual.get("ok") if manual else None,
        },
        "busy": auto_running or bool(top.strip()) or ostree.get("transaction") is not None,
        "restart_pending": pending,
        "restart_for": restart_for,
        "next_boot": deployment(next_boot),
        "booted": deployment(booted),
        "staged": deployment(staged),
        "rollback": deployment(rollback),
    }


def when(ts):
    if not ts:
        return "never"
    return time.strftime("%a %d %b %H:%M", time.localtime(ts))


def print_status(s):
    a = s["auto"]
    b = s["booted"] or {}
    print(f"System:            {b.get('image')}:{b.get('tag')} ({b.get('version')})")
    print(f"Channel:           {b.get('channel')}")
    print(f"Automatic updates: {'on' if a['enabled'] else 'off'}"
          f"{' (running now)' if a['running'] else ''}")
    print(f"  last run:        {when(a['last_run'])} ({a['last_result'] or 'n/a'})")
    if a["at"]:
        print(f"  runs daily at:   {a['at']} ({'default' if a['at_default'] else 'chosen'})")
    if a["enabled"]:
        print(f"  next run:        {when(a['next'])}")
    print(f"Last update now:   {when(s['now']['last_run'])}")
    if s["restart_for"] == "update":
        print("An update is ready: restart to finish it.")
    elif s["restart_for"] == "rollback":
        print("Going back to the previous system: restart to use it.")
    if s["rollback"]:
        r = s["rollback"]
        print(f"Previous system:   {r.get('image')}:{r.get('tag')} ({r.get('version')})")


def update_now():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    started = int(time.time())
    try:
        rc = subprocess.call(["topgrade", "--config", TOPGRADE_CONFIG])
    except OSError as error:
        print(f"Couldn't run topgrade: {error.strerror}", file=sys.stderr)
        rc = 127
    LAST_MANUAL.write_text(json.dumps(
        {"started": started, "finished": int(time.time()), "ok": rc == 0}))
    s = status()
    print()
    if s["restart_pending"]:
        print("Update finished. Restart to start the new system.")
    elif rc == 0:
        print("Everything is up to date.")
    else:
        print(f"The update finished with problems (topgrade exit status {rc}).")
    return rc


def main():
    parser = argparse.ArgumentParser(prog="redfox-updates",
                                     description="RedFoxOS updates.")
    parser.add_argument("--version", action="version", version=VERSION)
    sub = parser.add_subparsers(dest="command")
    p = sub.add_parser("status", help="show the state of updates")
    p.add_argument("--json", action="store_true")
    sub.add_parser("now", help="update everything now")
    p = sub.add_parser("auto", help="turn automatic updates on or off, or choose their hour")
    p.add_argument("state", choices=["on", "off", "at"])
    p.add_argument("hour", nargs="?", help="with at: HH:00, or default")
    sub.add_parser("restart", help="restart to finish an update")
    args = parser.parse_args()

    if args.command in (None, "status"):
        s = status()
        if getattr(args, "json", False):
            json.dump(s, sys.stdout)
            print()
        else:
            print_status(s)
        return 0
    if args.command == "now":
        return update_now()
    if args.command == "auto":
        helper = "/usr/libexec/redfox-updates-auto"
        argv = [helper, args.state]
        if args.state == "at":
            # Checked here too, so a typo doesn't ask for a password first
            if args.hour != "default" and not HOUR.fullmatch(args.hour or ""):
                print("redfox-updates: auto at takes a whole hour, HH:00 (00:00 to 23:00), "
                      "or default", file=sys.stderr)
                return 2
            argv.append(args.hour)
        elif args.hour is not None:
            parser.error(f"auto {args.state} takes no hour")
        if os.geteuid() == 0:
            return subprocess.call(argv)
        # pkexec asks for the password, in the desktop's dialog or on the
        # terminal (polkit action tech.redfoxlabs.hub.automatic-updates).
        return subprocess.call(["pkexec"] + argv)
    if args.command == "restart":
        return subprocess.call(["systemctl", "reboot"])
    return 1


if __name__ == "__main__":
    sys.exit(main())
