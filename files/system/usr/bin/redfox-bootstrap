#!/usr/bin/python3
"""redfox-bootstrap: set a computer up in one go from a setup profile.

  list [--json]   the profiles, and what each one does: its stages (settings,
                  apps, theme, layout) and their steps, described by the
                  ujust recipes themselves.
                  {"version": 1, "profiles": [{"id", "name", "summary",
                   "stages": [{"recipe", "doc", "steps": [{"recipe", "doc"}]}]}]}
  run ID          runs `ujust bootstrap-ID` in this terminal. Some steps ask
                  for your password, so RedFox Hub opens a terminal window for
                  it. At the end it prints what was done or skipped.

The steps set things the same way RedFox Hub's own switches do (the layout,
apps that start at login, Midikeep...), so Hub shows them afterwards.
"""

import argparse
import json
import os
import subprocess
import sys

VERSION = "1.0.0"
JUSTFILE = os.environ.get("REDFOX_JUSTFILE", "/usr/share/ublue-os/justfile")

PROFILES = [
    dict(id="matt", name="Matt",
         summary="Matt's setup: apps, settings for development and music, theme and layout."),
    dict(id="dewy", name="Dewy",
         summary="Dewy's setup: apps, settings, theme and layout."),
    dict(id="normie", name="Normie",
         summary="A simple everyday setup: the basic apps, an easy layout and plain settings."),
    dict(id="fedora", name="Fedora",
         summary="GNOME as Fedora ships it: its apps, its own layout and settings."),
]


def recipes():
    out = subprocess.run(["just", "--justfile", JUSTFILE, "--dump", "--dump-format", "json"],
                         capture_output=True, text=True, check=True).stdout
    return json.loads(out)["recipes"]


def expand(name, all_recipes, seen):
    """The steps a recipe runs, in order: its dependencies (each once), or
    the recipe itself when it has none. Private recipes (_name) are skipped."""
    recipe = all_recipes.get(name)
    if recipe is None or name.startswith("_") or name in seen:
        return []
    seen.add(name)
    deps = [d["recipe"] for d in recipe.get("dependencies", [])]
    if not deps:
        return [name]
    steps = []
    for dep in deps:
        steps += expand(dep, all_recipes, seen)
    # A recipe with dependencies can do something itself too.
    if any(line for line in recipe.get("body", []) if line):
        steps.append(name)
    return steps


def describe(name, all_recipes):
    return {"recipe": name, "doc": all_recipes[name].get("doc") or name}


def list_profiles():
    all_recipes = recipes()
    profiles = []
    for profile in PROFILES:
        top = all_recipes.get(f"bootstrap-{profile['id']}")
        if top is None:
            continue
        stages, seen = [], set()
        for dep in top.get("dependencies", []):
            stage = dep["recipe"]
            if stage.startswith("_") or stage not in all_recipes:
                continue
            steps = expand(stage, all_recipes, seen)
            stages.append({**describe(stage, all_recipes),
                           "steps": [describe(s, all_recipes) for s in steps if s != stage]})
        profiles.append({**profile, "stages": stages})
    return {"version": 1, "profiles": profiles}


def run(profile_id):
    code = subprocess.run(["ujust", f"bootstrap-{profile_id}"], check=False).returncode
    if sys.stdin.isatty():
        try:
            input("\nPress Enter to close this window. ")
        except EOFError:
            pass
    return code


def main(argv=None):
    parser = argparse.ArgumentParser(prog="redfox-bootstrap", description=__doc__.splitlines()[0])
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)
    p_list = sub.add_parser("list", help="show the profiles and what they do")
    p_list.add_argument("--json", action="store_true")
    p_run = sub.add_parser("run", help="run a profile")
    p_run.add_argument("id", choices=[p["id"] for p in PROFILES])
    args = parser.parse_args(argv)

    if args.command == "run":
        return run(args.id)
    data = list_profiles()
    if args.json:
        print(json.dumps(data))
        return 0
    for profile in data["profiles"]:
        print(f"{profile['name']} ({profile['id']}): {profile['summary']}")
        for stage in profile["stages"]:
            print(f"  {stage['doc']}")
            for step in stage["steps"]:
                print(f"    - {step['doc']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
