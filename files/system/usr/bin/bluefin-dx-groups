#!/usr/bin/env bash

# Test runs (never as root) can point the files below at a scratch folder.
ROOT=""
[ "$(id -u)" -ne 0 ] && ROOT="${REDFOX_TEST_ROOT:-}"

GSHADOW="$ROOT/etc/gshadow"

# Remove /etc/gshadow entries for groups that exist nowhere. Existence is checked with
# getent, which sees both /etc/group and the image's /usr/lib/group (nss-altfiles).
# (grpck only knows /etc/group, so it treats every /usr/lib/group entry as orphaned.)
repair_gshadow() {
  if ! getent group root >/dev/null; then
    echo "Group lookups are not working; leaving $GSHADOW untouched."
    return 1
  fi

  local name orphans=()
  while IFS=: read -r name _; do
    [ -n "$name" ] || continue
    getent group "$name" >/dev/null || orphans+=("$name")
  done <"$GSHADOW"

  if [ ${#orphans[@]} -eq 0 ]; then
    echo "No orphaned $GSHADOW entries found."
    return 0
  fi
  echo "Removing $GSHADOW entries for groups that don't exist: ${orphans[*]}"

  # Build the new file next to the original and only swap it in if every step succeeded
  local tmp expected
  tmp=$(mktemp "$(dirname "$GSHADOW")/.gshadow.XXXXXX") || return 1
  expected=$(($(wc -l <"$GSHADOW") - ${#orphans[@]}))
  if ! awk -F: -v drop="$(printf '%s\n' "${orphans[@]}")" \
      'BEGIN { n = split(drop, list, "\n"); for (i = 1; i <= n; i++) skip[list[i]] = 1 } !($1 in skip)' \
      "$GSHADOW" >"$tmp" ||
    [ "$(wc -l <"$tmp")" -ne "$expected" ] ||
    ! chown --reference="$GSHADOW" "$tmp" ||
    ! chmod --reference="$GSHADOW" "$tmp" ||
    ! cp -a "$GSHADOW" "$GSHADOW-"; then
    echo "Could not prepare a repaired $GSHADOW; leaving it untouched."
    rm -f "$tmp"
    return 1
  fi
  chcon --reference="$GSHADOW" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$GSHADOW"
}

# Create system users/groups declared by packages (e.g. ClamAV's clamupdate/virusgroup).
# systemd-sysusers.service is normally skipped on image-based systems, so run it every boot.
# It refuses to create a group that already has a stale gshadow entry (which image updates
# can leave behind); only in that case, drop entries for nonexistent groups and retry.
echo "Regenerating system users..."
if ! systemd-sysusers; then
  echo "systemd-sysusers failed; checking $GSHADOW for entries of groups that don't exist..."
  repair_gshadow && systemd-sysusers || echo "systemd-sysusers is still failing; see the messages above."
fi

# systemd-tmpfiles-setup ran earlier in boot, before any users added above existed, so entries
# owned by them (e.g. ClamAV's /var/lib/clamav) were skipped. Create them now.
systemd-tmpfiles --create || true

# docker, incus-admin and libvirt are as good as root: members control containers and VMs
# that can reach the whole system. Administrators (members of wheel) get them.
DX_GROUPS=(docker incus-admin libvirt)
# The memberships this script manages, one "user:group" per line.
MANAGED_FILE="$ROOT/etc/ublue/dx-groups-managed"

mkdir -p "$ROOT/etc/ublue"

wheel_members() { getent group wheel | cut -d ":" -f 4 | tr ',' '\n' | sed '/^$/d'; }
in_group() { id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qx -- "$2"; }

# Every start: an account that is no longer an administrator leaves the groups this script
# manages for it. Memberships added by hand for other accounts aren't recorded and stay.
if [ -s "$MANAGED_FILE" ]; then
  mapfile -t admins < <(wheel_members)
  keep=()
  while IFS=: read -r user group; do
    [ -n "$user" ] && [ -n "$group" ] || continue
    if printf '%s\n' "${admins[@]}" | grep -qx -- "$user"; then
      keep+=("$user:$group")
    elif in_group "$user" "$group"; then
      if gpasswd -d "$user" "$group" >/dev/null; then
        echo "Took $user out of $group: no longer an administrator"
      else
        echo "Couldn't take $user out of $group; trying again next start"
        keep+=("$user:$group")
      fi
    fi
  done <"$MANAGED_FILE"
  printf '%s\n' "${keep[@]}" | sed '/^$/d' >"$MANAGED_FILE.tmp" && mv -f "$MANAGED_FILE.tmp" "$MANAGED_FILE"
fi

# SCRIPT VERSION (increment this number every time you update this script)
GROUP_SETUP_VER=5
GROUP_SETUP_VER_FILE="$ROOT/etc/ublue/dx-groups"
GROUP_SETUP_VER_RAN=$(cat "$GROUP_SETUP_VER_FILE" 2>/dev/null || echo "0")

# Run script if updated
if [[ -f $GROUP_SETUP_VER_FILE && "$GROUP_SETUP_VER" = "$GROUP_SETUP_VER_RAN" ]]; then
  echo "Group setup has already run. Exiting..."
  exit 0
fi

# Function to append a group entry to /etc/group, from the image's /usr/lib/group
# or, for groups that packages created at build time, the image's own /etc (/usr/etc)
append_group() {
  local group_name="$1"
  if ! getent group "$group_name" >/dev/null; then
    local line
    line=$(grep -h "^$group_name:" /usr/lib/group /usr/etc/group 2>/dev/null | head -n1)
    if [ -n "$line" ]; then
      echo "Appending $group_name to /etc/group"
      echo "$line" >>"$ROOT/etc/group"
    else
      echo "No $group_name group in the image; skipping it."
    fi
  fi
}

# Setup Groups
for group in "${DX_GROUPS[@]}"; do
  append_group "$group"
done

# Every administrator, not just the first ("${wheelarray[@]}", not "$wheelarray"). Their
# memberships are recorded, so they're taken away again if the account stops being one.
# One account that can't be changed doesn't stop the others.
mapfile -t wheelarray < <(wheel_members)
for user in "${wheelarray[@]}"; do
  for group in "${DX_GROUPS[@]}"; do
    getent group "$group" >/dev/null || continue
    if in_group "$user" "$group" || usermod -aG "$group" "$user"; then
      grep -qx -- "$user:$group" "$MANAGED_FILE" 2>/dev/null || echo "$user:$group" >>"$MANAGED_FILE"
    else
      echo "Couldn't add $user to $group; skipping it."
    fi
  done
done

# Prevent future executions
echo "Writing state file"
echo "$GROUP_SETUP_VER" >"$GROUP_SETUP_VER_FILE"
