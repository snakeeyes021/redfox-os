#!/usr/bin/python3
"""RedFox Hub: RedFoxOS's welcome, apps, updates, settings and manual.

    redfox-hub                      open Hub
    redfox-hub --page updates       open a page (settings/layout, manual/apps, ...)
    redfox-hub --welcome            show the welcome tour
    redfox-hub --first-login        show the welcome tour, once per user
"""
import os
import sys

sys.path.insert(0, os.environ.get("REDFOX_HUB_DIR", "/usr/share/redfox/hub"))
