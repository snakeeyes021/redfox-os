#!/usr/bin/bash
# Shown when the live session starts: install RedFoxOS, or keep trying it.

# The ISO only boots with UEFI; a machine in legacy (CSM) mode can't install.
if [[ ! -d /sys/firmware/efi ]]; then
    yad --undecorated --on-top --timeout=0 --button="Shut Down:0" \
        --text="RedFoxOS needs UEFI to start. This computer started in legacy (CSM) mode.\n\nIn the computer's firmware settings, turn off CSM/Legacy mode, then try again." || true
    systemctl poweroff
    exit 0
fi

memory_kb=$(awk '/^MemTotal/ {print $2}' /proc/meminfo)
memory_note=""
if [[ ${memory_kb:-0} -gt 0 && $memory_kb -lt 7000000 ]]; then
    memory_note="\n\n<b>This computer has $((memory_kb / 1024 / 1024 + 1)) GB of memory.</b> RedFoxOS needs at least 8 GB; the installation may fail."
fi

yad --on-top --no-escape --center --title="Welcome to RedFoxOS" \
    --window-icon=redfox-logo --image=redfox-logo --buttons-layout=center \
    --text="<big><b>Welcome to RedFoxOS</b></big>\n\nThis is the live system: try RedFoxOS, then install it.\nIt runs from the USB stick, so it's slower than the installed system,\nand several apps are added after installation, at the first start.${memory_note}" \
    --button="Install RedFoxOS:10" --button="Try It First:0"
if [[ $? -eq 10 ]]; then
    liveinst &
    disown
fi
